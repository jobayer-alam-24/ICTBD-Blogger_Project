@using Blogger.Data
@model ApplicationRole
@{
    ViewData["Title"] = "Create Role";
}

<partial name="~/Views/Shared/Common/_TitleNavigationPartial.cshtml"
         model='("Create Role", "/", "Dashboard", "Roles")' />

@if (TempData["role_used_error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["role_used_error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="card p-4">
    <div class="card-body">
        <h2 class="text-center">Create New Role</h2>
        <form asp-action="AddNewRole" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Role Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter role name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control w-full p-2 border border-gray-300 rounded-md"
                          placeholder="Enter role description" rows="4" cols="50" style="resize: none;"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-success">Create</button>
                <a asp-action="List" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts
{
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml"></partial>
}