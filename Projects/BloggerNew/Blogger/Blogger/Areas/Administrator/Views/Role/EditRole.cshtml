@using Blogger.ViewModel.EditRoleViewModel
@model EditRoleViewModel
@{
    ViewData["Title"] = "Edit Role";
}

<partial name="~/Views/Shared/Common/_TitleNavigationPartial.cshtml"
model='($"Edit -> {Model.Name}", "/", "Dashboard", "Roles")' />

<div class="card p-4">
    <div class="card-body">
        <h2 class="text-center">Edit -> @Model.Name</h2>
        <form href="~/Administrator/Role/EditRole" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Id" class="form-label fw-bold">ID</label>
                <input asp-for="Id" class="form-control bg-light text-dark fw-semibold" readonly />
                <span asp-validation-for="Id" class="text-danger mt-1 d-block"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Role Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter role name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control w-full p-2 border border-gray-300 rounded-md"
                placeholder="Enter role description" rows="4" cols="50" style="resize: none;"></textarea>

                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-success">Save Changes</button>
                <a href="~/Administrator/Role/List" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
<div class="card mt-4">
    <div class="card-header">
        <h3 class="card-title">Users with @Model.Name Role</h3>
    </div>
    <div class="card-body">
        <ul class="list-group">
            @if(Model.UserNames.Any())
            {
                foreach(var name in Model.UserNames)
                {
                    <li class="list-group-item">@name</li>
                }
            }
            else
            {
                <li class="list-group-item">No User has been Assigned to @Model.Name</li>
            }
        </ul>
    </div>
    <div class="card-footer text-end">
        <button class="btn btn-primary" type="button" id="roleToggleBtn">
            <a href="~/Administrator/Role/AssignUserRole?roleid=@Model.Id" class="text-white">
                <i class="bi bi-person-plus-fill" id="roleIcon"></i> Add or Remove Role
            </a>
        </button>
    </div>
</div>


@section Scripts
{
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml"></partial>
}