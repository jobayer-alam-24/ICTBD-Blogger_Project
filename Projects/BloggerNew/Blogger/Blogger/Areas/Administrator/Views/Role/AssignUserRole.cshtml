@using Blogger.ViewModel.UserRoleViewModel
@model List<UserRoleViewModel>
@{
    ViewData["Title"] = "Assign Role To User";
}
<partial name="~/Views/Shared/Common/_TitleNavigationPartial.cshtml" model='("Assign Role To User", "/", "Dashboard", "Roles")' />
<div asp-validation-summary="All" class="text-danger"></div>

<form action="/Administrator/Role/AssignUserRole?roleid=@ViewBag.RoleId"  method="post">
    @Html.AntiForgeryToken()
    <div class="card shadow-lg border-0 mt-4">
        <div class="card-header bg-secodary bg-info text-white">
            <h2 class="card-title mb-0">Assign <span class="text-light fw-bold">@ViewBag.RoleName</span> to Users</h2>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                @if (Model.Any())
                {
                    int length = Model.Count;
                    for (int i = 0; i < length; i++)
                    {
                        <li class="list-group-item">
                            <input type="hidden" asp-for="@Model[i].UserId" />
                            <input type="checkbox" asp-for="@Model[i].IsSelected" />
                            <label asp-for="@Model[i].IsSelected">@Model[i].UserName</label>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">No users available</li>
                }
            </ul>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2 bg-light">
            <a href="~/Administrator/Role/EditRole?roleid=@ViewBag.RoleId" class="btn btn-secondary text-white">Cancel</a>
            <button class="btn btn-success" type="submit" id="updateBtn">Update</button>
        </div>
    </div>
</form>

@section Scripts
{
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml"></partial>
}
