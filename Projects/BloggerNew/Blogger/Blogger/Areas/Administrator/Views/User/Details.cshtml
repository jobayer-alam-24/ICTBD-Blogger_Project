@using Blogger.Data
@model ApplicationUser

@{
    ViewData["Title"] = "User Details";
}
<partial name="~/Views/Shared/Common/_TitleNavigationPartial.cshtml"
         model='("User Details", "/", "Dashboard", "User")'></partial>
<div class="container mt-4">
    <div class="card shadow-lg p-4 rounded">

        <div class="text-center mb-4">
            @if(Model.Media != "NONE")
            {
            <img src="/User/Images/@Model.Media" alt="User Image" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 2px solid #007bff;" asp-append-version="true">
            }
            else
            {
			<img src="~/User/Images/user.png" alt="User Image" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 2px solid #007bff;" asp-append-version="true">
            }
        </div>
        <h2 class="text-center text-primary mb-4"> User Details</h2>

        <div class="row">
            <div class="col-md-6 mb-3">
                <h5 class="fw-bold">First Name:</h5>
                <p class="text-muted">@Model.FirstName</p>
            </div>
            <div class="col-md-6 mb-3">
                <h5 class="fw-bold">Last Name:</h5>
                <p class="text-muted">@Model.LastName</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <h5 class="fw-bold">Age:</h5>
                <p class="text-muted">@Model.Age</p>
            </div>
            <div class="col-md-6 mb-3">
                <h5 class="fw-bold">Email:</h5>
                <p class="text-muted">@Model.Email</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <h5 class="fw-bold">Phone Number:</h5>
                <p class="text-muted">@Model.PhoneNumber</p>
            </div>
        </div>

        <div class="d-flex justify-content-center mt-4">
            <a href="~/Administrator/User/Edit/@Model.Id" class="btn btn-primary px-4">✏️ Edit</a>
            <a href="~/Administrator/User/List" class="btn btn-secondary ms-3">↩️ Back</a>
        </div>
    </div>
</div>
