@using Blogger.Data
@model List<ApplicationUser>

@{
    ViewData["Title"] = "User List";
}
<partial name="~/Views/Shared/Common/_TitleNavigationPartial.cshtml"
         model='("Create A User", "/", "Dashboard", "User")'></partial>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">User List</h2>
        <a href="~/Administrator/User/Create" class="btn btn-success">➕ Create New User</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover shadow-sm rounded table-bordered align-middle">
            <thead class="table-dark text-light">
                <tr>
                    <th>Id</th>
                    <th>Image</th> <!-- New Image Column -->
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center">No users found</td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr class="align-middle text-center">
                            <td class="text-muted fw-bold">@user.Id</td>
                            <td class="text-center">
                                @if (user.Media != "NONE")
                                {
                                    <img src="/User/Images/@user.Media" alt="User Image" class="rounded-circle" width="50" height="50" />
                                }
                                else
                                {
                                    <img src="/User/Images/user.png" alt="User Image" class="rounded-circle" width="50" height="50" />
                                }
                            </td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Age</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td class="text-center">
                                <a href="~/Administrator/User/Edit/@user.Id" class="btn btn-warning btn-sm mx-1">✏️ Edit</a> <br /><br />
                                <a href="~/Administrator/User/Details/@user.Id" class="btn btn-info btn-sm mx-1">ℹ️ Details</a><br /><br />
                                <a href="~/Administrator/User/Delete/@user.Id" onclick="return confirm('Are you sure you want to delete this?')" class="btn btn-danger btn-sm mx-1">🗑️ Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
