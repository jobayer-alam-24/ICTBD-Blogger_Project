@model List<ApplicationUser>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">User List</h2>
        <a asp-action="Create" class="btn btn-success">➕ Create New User</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover shadow-sm rounded">
            <thead class="table-dark text-light">
                <tr>
                    <th>Id</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center">No users found</td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr class="align-middle">
                            <td class="text-muted fw-bold">@user.Id</td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Age</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm mx-1">✏️ Edit</a>
                                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm mx-1">ℹ️ Details</a>
                                <a asp-action="Delete" onclick="return confirm('Are you sure you want to delete this?')" asp-route-id="@user.Id" class="btn btn-danger btn-sm mx-1">🗑️ Delete</a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>
