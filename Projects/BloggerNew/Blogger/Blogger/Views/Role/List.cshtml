@model List<IdentityRole>
@{
    ViewData["Title"] = "Role List";
}
<partial name="~/Views/Shared/Common/_TitleNavigationPartial.cshtml"
         model='("List Of Roles", "/", "Dashboard", "Lists")' />

<div class="row">
    <p class="col-12 text-end">
        <a asp-action="AddNewRole" role="button" class="btn btn-info fs-5">Add New Role</a>
    </p>
</div>

<div class="card p-2">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Role Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td class="fw-bold">@role.Id</td>
                            <td class="text-capitalize">@role.Name</td>
                            <td>
                                <div class="d-flex gap-2 align-items-center justify-content-center">
                                    <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-sm btn-primary">Edit</a>
                                    <form asp-action="DeleteRole" asp-route-id="@role.Id">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this role?')">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
