@model SignUpViewModel
@{
	Layout = "~/Views/Shared/_AuthLayout.cshtml";
	ViewData["Title"] = "Sign Up";
}
<div class="col-md-8 col-lg-6 col-xl-5">
    <div class="card overflow-hidden">
        <div class="bg-primary bg-soft">
            <div class="row">
                <div class="col-7">
                    <div class="text-primary p-4">
                        <h5 class="text-primary">Register Here</h5>
                        <p>Get your Blogger account now.</p>
                    </div>
                </div>
                <div class="col-5 align-self-end">
                    <img src="assets/images/profile-img.png" alt="" class="img-fluid">
                </div>
            </div>
        </div>
        <div class="card-body pt-0">
            <div>
                <a href="/Sign-up">
                    <div class="avatar-md profile-user-wid mb-4">
                        <span class="avatar-title rounded-circle bg-light">
                            <img src="@Default.LogoPath" alt="" class="rounded-circle" height="34">
                        </span>
                    </div>
                </a>
            </div>
            <div class="p-2">
                <form class="needs-validation" asp-action="SignUp" asp-controller="Authentication">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input type="text" asp-for="FirstName" class="form-control" required="" placeholder="First name">
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input type="text" asp-for="LastName" class="form-control" placeholder="Last name" required="">
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input type="number" asp-for="Age" class="form-control" id="userage" placeholder="Enter age" required>
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                        <input asp-for="PhoneNumber" type="number" class="form-control" placeholder="Enter Phone Number" min="11" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input type="email" asp-for="Email" class="form-control" id="useremail" placeholder="Enter email" required>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group auth-pass-inputgroup">
                            <input type="password" asp-for="Password" class="form-control" placeholder="Enter password" id="Pass" aria-label="Password" aria-describedby="password-addon">
                            <button class="btn btn-light " type="button" id="PassBtn">show</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="input-group auth-pass-inputgroup">
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Enter confirm password" aria-label="Password" aria-describedby="password-addon" id="confirmPass">
                            <button class="btn btn-light " type="button" id="confirmBtn">show</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mt-4 d-grid">
                        <button class="btn btn-primary waves-effect waves-light" type="submit">Register</button>
                    </div>

                    <div class="mt-4 text-center">
                        <h5 class="font-size-14 mb-3">Sign up using</h5>

                        <ul class="list-inline">
                            <li class="list-inline-item">
                                <a href="javascript::void()" class="social-list-item bg-primary text-white border-primary">
                                    <i class="mdi mdi-facebook"></i>
                                </a>
                            </li>
                            <li class="list-inline-item">
                                <a href="javascript::void()" class="social-list-item bg-info text-white border-info">
                                    <i class="mdi mdi-twitter"></i>
                                </a>
                            </li>
                            <li class="list-inline-item">
                                <a href="javascript::void()" class="social-list-item bg-danger text-white border-danger">
                                    <i class="mdi mdi-google"></i>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-4 text-center">
                        <p class="mb-0">By registering you agree to the Blogger <a href="#" class="text-primary">Terms of Use</a></p>
                    </div>
                </form>
            </div>

        </div>
    </div>
    <div class="mt-5 text-center">

        <div>
            <p>Already have an account ? <a href="/sign-in" class="fw-medium text-primary"> Sign In</a> </p>
        </div>
    </div>
</div>
@section Scripts
{
    <script>
        $(document).ready(function() {
            var btn = $("#confirmBtn");
            var inputPassword = $("#confirmPass");
            var mainPassBtn = $("#PassBtn");
            var mainPass = $("#Pass");
            togglePassword(btn, inputPassword);
            togglePassword(mainPassBtn, mainPass);
            function togglePassword(btn, inputPassword) {
            btn.on("click", function () {
                var type = inputPassword.attr("type");
                if (type == "text") {
                    inputPassword.attr("type", "password");
                    btn.text("show");
                } else {
                    inputPassword.attr("type", "text");
                    btn.text("hide"); 
                }
            });
        }
        });
    </script>
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml"></partial>
}